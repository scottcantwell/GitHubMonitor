<Window x:Class="GitHubMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitHubMonitor.ViewModels"
        xmlns:b="clr-namespace:GitHubMonitor.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="GitHub Monitor"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="#F4F5F7"
        Loaded="OnLoaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Height="30">
            <MenuItem Header="_File">
                <MenuItem Header="_Quit"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Criteria"
                  IsCheckable="True"
                  IsChecked="{Binding IsCriteriaVisible, Mode=TwoWay}"/>
                <MenuItem Header="_Results"
                  IsCheckable="True"
                  IsChecked="{Binding IsResultsVisible, Mode=TwoWay}"/>
                <MenuItem Header="_Log"
                  IsCheckable="True"
                  IsChecked="{Binding IsLogVisible, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="Show _all"
                  Command="{Binding ShowAllSectionsCommand}"/>
            </MenuItem>
        </Menu>
        <Grid x:Name="RootGrid" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CriteriaColumn" Width="340" MinWidth="220"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="8"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
              Background="White"
              CornerRadius="8"
              Padding="16"
              Visibility="{Binding IsCriteriaVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Criteria" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource Label}" Text="Keywords"/>
                        <TextBox Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Language"/>
                        <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Topic"/>
                        <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Label}" Text="User"/>
                        <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Organization"/>
                        <TextBox Text="{Binding Org, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Extra GitHub qualifiers"/>
                        <TextBox Text="{Binding ExtraQualifiers, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Min stars"/>
                                <TextBox Text="{Binding MinStars, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Created within (hours)"/>
                                <TextBox Text="{Binding CreatedWithinHours, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Poll interval (min)"/>
                                <TextBox Text="{Binding PollIntervalMinutes}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Max results / poll"/>
                                <TextBox Text="{Binding MaxResultsPerPoll}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Exclude forks" IsChecked="{Binding ExcludeForks}" Margin="0,0,0,6"/>
                        <CheckBox Content="Exclude archived" IsChecked="{Binding ExcludeArchived}" Margin="0,0,0,6"/>
                        <CheckBox Content="Toast on first poll too" IsChecked="{Binding NotifyOnStartSeed}" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource Label}" Text="GitHub personal access token"/>
                        <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Optional but recommended. Avoids the 10 req/min anonymous cap."
                       TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,16"/>

                        <Button Content="{Binding StartStopLabel}" Height="36"
                    Command="{Binding ToggleMonitorCommand}"/>
                        <Button Content="Poll once" Height="32" Margin="0,8,0,0"
                    Command="{Binding PollOnceCommand}"/>
                        <Button Content="Clear seen history" Height="32" Margin="0,8,0,0"
                    Command="{Binding ClearSeenCommand}"/>

                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding QueryPreview}" TextWrapping="Wrap" Margin="0,8,0,0"
                       FontFamily="Consolas" FontSize="11" Foreground="#666"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#DDD"
                    ShowsPreview="True"
                    ResizeBehavior="PreviousAndNext"
                    DragCompleted="OnColumnSplitterDragCompleted"
                    Visibility="{Binding IsCriteriaVisible, Converter={StaticResource BoolToVis}}"/>

            <Grid x:Name="ResultsGrid"
            Grid.Column="2"
            Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition x:Name="LogSplitterRow" Height="8"/>
                    <RowDefinition x:Name="LogRow" Height="140" MinHeight="60"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="New matches"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

                <ListView Grid.Row="1"
                  ItemsSource="{Binding Repositories}"
                  SelectedItem="{Binding SelectedRepository}"
                  MouseDoubleClick="OnRepoDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Repository" Width="260" DisplayMemberBinding="{Binding FullName}"/>
                            <GridViewColumn Header="Language" Width="110" DisplayMemberBinding="{Binding LanguageText}"/>
                            <GridViewColumn Header="Stars" Width="70" DisplayMemberBinding="{Binding StarsText}"/>
                            <GridViewColumn Header="Created" Width="150" DisplayMemberBinding="{Binding CreatedText}"/>
                            <GridViewColumn Header="Description" Width="320" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Row="2"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#DDD"
                      ShowsPreview="True"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnRowSplitterDragCompleted"
                      Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}"/>

                <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="12"
                Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Log"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
                            <Button Content="Clear log"
                      HorizontalAlignment="Right"
                      Padding="10,2"
                      Command="{Binding ClearLogCommand}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding LogLines}"
                     FontFamily="Consolas"
                     FontSize="12"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     b:ListBoxAutoScrollBehavior.AutoScroll="True"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>